# MarketingTeam — Environment Şablonu
#
# Bu dosyayı `.env` olarak kopyala ve gerçek değerleri yaz.
# `.env` dosyası asla repo'ya commit'lenmez (.gitignore içinde).
#
# Tüm bu tokenları Phase 4'te ihtiyaç oldukça mt-entegrasyon-kurucu ajanı ile alacaksın.

# ─── Meta Marketing API ──────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=

# ─── TikTok Business API ─────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ─── Apple Search Ads Campaign Management API ────────────────
ASA_CLIENT_ID=
ASA_TEAM_ID=
ASA_KEY_ID=
ASA_PRIVATE_KEY_PATH=

# ─── Google Ads API ──────────────────────────────────────────
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CUSTOMER_ID=

# ─── RevenueCat (zaten MCP üzerinden bağlı, gerekirse REST için) ──
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_SECRET_API_KEY=

# ─── AppsFlyer / Adjust (kullanıyorsan) ──────────────────────
APPSFLYER_DEV_KEY=
APPSFLYER_API_TOKEN=
ADJUST_API_TOKEN=

# ─── Diğer Servisler ─────────────────────────────────────────
# Sensor Tower, Data.ai, AppTweak vb. API'leri buraya ekle
