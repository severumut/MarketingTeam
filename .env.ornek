# MarketingTeam — Environment Şablonu
#
# Bu dosyayı `.env` olarak kopyala ve gerçek değerleri yaz.
# `.env` dosyası asla repo'ya commit'lenmez (.gitignore içinde).
#
# Tüm bu tokenları Phase 4'te ihtiyaç oldukça mt-entegrasyon-kurucu ajanı ile alacaksın.

# ─── Meta Marketing API ──────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=

# ─── TikTok Business API ─────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ─── Apple Search Ads Campaign Management API ────────────────
ASA_CLIENT_ID=
ASA_TEAM_ID=
ASA_KEY_ID=
ASA_PRIVATE_KEY_PATH=

# ─── App Store Connect API (organik App Store verisi — JWT auth) ──
# Apple Search Ads'ten FARKLI: bu organik indirme/analytics/metadata/review verisi.
# Token alma: App Store Connect → Users and Access → Integrations → Team Keys (rol: Admin)
# .p8 private key bir kez indirilir; *.p8 .gitignore'da.
ASC_ISSUER_ID=          # Integrations sayfasının üstünde — UUID formatında
ASC_KEY_ID=             # Anahtar tablosundaki 10 karakterlik kimlik
ASC_PRIVATE_KEY_PATH=   # örn. entegrasyonlar/app-store-connect/AuthKey_XXXXXXXXXX.p8
ASC_VENDOR_NUMBER=      # sadece Satış & Finans raporları için (Payments & Financial Reports'ta)

# ─── Google Ads API ──────────────────────────────────────────
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CUSTOMER_ID=

# ─── RevenueCat (zaten MCP üzerinden bağlı, gerekirse REST için) ──
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_SECRET_API_KEY=

# ─── AppsFlyer / Adjust (kullanıyorsan) ──────────────────────
APPSFLYER_DEV_KEY=
APPSFLYER_API_TOKEN=
ADJUST_API_TOKEN=

# ─── fal.ai (Creative üretim — image, video, audio motorları) ──
# Aktif kullanılır: mt-creative-yonetmeni, mt-content-uretici, mt-aso-uzmani
# Token alma: https://fal.ai/dashboard/keys
FAL_KEY=

# ─── Shotstack (Creative post-production — video editing API) ──
# Aktif kullanılır: mt-creative-yonetmeni (concat, captions, logo, music sync)
# Token alma: https://app.shotstack.io (Stage credentials test için ücretsiz)
SHOTSTACK_API_KEY=
SHOTSTACK_OWNER_ID=

# ─── Diğer Servisler ─────────────────────────────────────────
# Sensor Tower, Data.ai, AppTweak vb. API'leri buraya ekle
